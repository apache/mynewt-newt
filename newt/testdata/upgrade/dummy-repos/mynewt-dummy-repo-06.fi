repo.name: mynewt-dummy-repo-06
repo.versions:
    "0.0.0": "master"
    "1.0.0": "mynewt_1_0_0_tag"
    "2.0.0": "mynewt_2_0_0_tag"

    "0-dev": "0.0.0"

# Version 2.0.0 replaced the dependency on repo 04 with repo 05.  master
# requires a version of repo 05 other than its master, so that a skipped
# dependency is not hidden by a fresh clone.
repo.deps:
    mynewt-dummy-repo-04:
        type: git
        url: https://dummy.invalid/mynewt-dummy-repo-04.git
        vers:
            mynewt_1_0_0_tag: 1.0.0

    mynewt-dummy-repo-05:
        type: git
        url: https://dummy.invalid/mynewt-dummy-repo-05.git
        vers:
            master: 1.0.0
            mynewt_2_0_0_tag: 2.0.0

